#include <winver.h>

#define MP_STRING2(x) #x
#define MP_STRING(x) MP_STRING2(x)

3 ICON "icon.ico"
1 24 "MouseParty.exe.manifest"

1 VERSIONINFO
FILEVERSION MP_VERSION_NUMBERS
PRODUCTVERSION MP_VERSION_NUMBERS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Paul Ford"
            VALUE "FileDescription", "Mouse Party"
            VALUE "FileVersion", MP_STRING(MP_VERSION)
            VALUE "InternalName", "MouseParty"
            VALUE "LegalCopyright", "Copyright (c) 2026 Paul Ford"
            VALUE "OriginalFilename", "MouseParty.exe"
            VALUE "ProductName", "Mouse Party"
            VALUE "ProductVersion", MP_STRING(MP_VERSION)
            VALUE "Comments", "Have friends over: movies, chat and games, hosted from this computer."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
