<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What Mouse Party needs of the hardened runtime a Developer ID build is signed with
     (scripts/build_mac_app.sh). wazero (wasm.go) compiles pandoc and Python to machine code in
     memory it writes and then makes executable, without MAP_JIT: that's unsigned executable memory. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
